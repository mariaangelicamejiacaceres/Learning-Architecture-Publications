<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Publications, ideas and frameworks from the Learning Architecture Lab.">
<title>Publications — Learning Architecture Lab</title>
<style>
  :root {
    /* Keep these neutral by default. Update only after checking official LPI brand guidelines. */
    --brand: #214b45;
    --brand-contrast: #ffffff;
    --text: #202522;
    --muted: #5f6863;
    --surface: #ffffff;
    --surface-soft: #f5f6f3;
    --border: #dfe4df;
    --accent: #e8eee8;
    --radius: 14px;
    --content-width: 1120px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; color: var(--text); background: var(--surface);
    font-family: Arial, Helvetica, sans-serif; line-height: 1.55;
  }
  a { color: inherit; }
  .site-shell { max-width: var(--content-width); margin: 0 auto; padding: 0 28px; }
  .institutional-bar {
    border-bottom: 1px solid var(--border); background: var(--surface);
  }
  .institutional-bar .inner {
    min-height: 56px; display: flex; align-items: center; justify-content: space-between;
    gap: 16px; font-size: .86rem;
  }
  .brand-label { font-weight: 700; letter-spacing: .015em; }
  .lab-label { color: var(--muted); }
  .hero { padding: clamp(44px, 8vw, 92px) 0 48px; border-bottom: 1px solid var(--border); }
  .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .76rem; font-weight: 700; color: var(--muted); }
  h1 { margin: 12px 0 18px; max-width: 820px; font-size: clamp(2.6rem, 7vw, 5.4rem); letter-spacing: -.055em; line-height: .98; font-weight: 700; }
  .intro { max-width: 720px; font-size: clamp(1.05rem, 2vw, 1.28rem); color: var(--muted); margin: 0; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--brand); background: var(--brand); color: var(--brand-contrast); text-decoration: none; font-weight: 700; font-size: .92rem; }
  .button.secondary { background: transparent; color: var(--text); border-color: var(--border); }
  section { padding: 48px 0; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 22px; }
  h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.25rem); letter-spacing: -.035em; line-height: 1.1; }
  .section-note { max-width: 480px; margin: 8px 0 0; color: var(--muted); }
  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; }
  .featured-card { padding: 22px; border: 1px solid var(--border); border-radius: var(--radius); min-height: 235px; display: flex; flex-direction: column; background: var(--surface); }
  .number { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); font-weight: 700; margin-bottom: 22px; }
  .tag { font-size: .75rem; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); font-weight: 700; }
  .featured-card h3 { font-size: 1.23rem; line-height: 1.25; margin: 8px 0; letter-spacing: -.02em; }
  .featured-card p { color: var(--muted); margin: 0 0 18px; font-size: .94rem; }
  .text-link { margin-top: auto; font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .collection { background: var(--surface-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .toolbar { display: grid; grid-template-columns: minmax(220px, 1.5fr) repeat(2, minmax(150px, .8fr)); gap: 10px; margin: 24px 0 10px; }
  input, select { width: 100%; min-height: 46px; border: 1px solid #cbd3cd; border-radius: 8px; background: var(--surface); color: var(--text); padding: 10px 12px; font: inherit; }
  input:focus, select:focus, a:focus-visible, button:focus-visible { outline: 3px solid #6b9c8d; outline-offset: 2px; }
  .results-line { display: flex; justify-content: space-between; align-items: center; gap: 12px; color: var(--muted); font-size: .9rem; margin: 14px 0; }
  .publication-list { display: grid; gap: 10px; }
  .publication { display: grid; grid-template-columns: 58px minmax(0,1fr) auto; gap: 18px; align-items: start; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; }
  .publication-index { color: var(--muted); font-size: .86rem; padding-top: 4px; }
  .publication h3 { font-size: 1.08rem; line-height: 1.35; margin: 0 0 6px; }
  .publication .description { margin: 8px 0 0; color: var(--muted); font-size: .94rem; }
  .meta { color: var(--muted); font-size: .82rem; display: flex; flex-wrap: wrap; gap: 6px 12px; }
  .pill { display: inline-block; background: var(--accent); border-radius: 999px; padding: 4px 9px; color: var(--text); font-size: .75rem; white-space: nowrap; }
  .publication-action { align-self: center; white-space: nowrap; font-size: .88rem; font-weight: 700; }
  .empty { padding: 32px; text-align: center; color: var(--muted); background: var(--surface); border: 1px dashed var(--border); border-radius: 12px; }
  .closing { padding: 42px 0; }
  .closing-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 28px; border-radius: var(--radius); background: var(--accent); }
  .closing p { margin: 8px 0 0; color: var(--muted); max-width: 650px; }
  footer { border-top: 1px solid var(--border); padding: 22px 0; color: var(--muted); font-size: .82rem; }
  .small-print { margin-top: 16px; font-size: .78rem; color: var(--muted); }
  @media (max-width: 760px) {
    .site-shell { padding: 0 18px; }
    .featured-grid { grid-template-columns: 1fr; }
    .featured-card { min-height: auto; }
    .toolbar { grid-template-columns: 1fr; }
    .publication { grid-template-columns: 30px minmax(0,1fr); gap: 12px; padding: 16px; }
    .publication-action { grid-column: 2; justify-self: start; }
    .section-heading, .closing-inner { align-items: flex-start; flex-direction: column; }
    .institutional-bar .inner { align-items: flex-start; flex-direction: column; justify-content: center; padding-top: 10px; padding-bottom: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
</head>
<body>
<header class="institutional-bar">
  <div class="site-shell inner">
    <div class="brand-label">Learning Planet Institute</div>
    <div class="lab-label">Learning Architecture Lab</div>
  </div>
</header>

<main>
  <div class="site-shell">
    <header class="hero">
      <div class="eyebrow">Learning Architecture Lab · Research & resources</div>
      <h1>Publications</h1>
      <p class="intro">Ideas, reflections, frameworks and conversations exploring Learning Architecture.</p>
      <p class="intro" style="font-size:1rem;margin-top:12px">A growing collection of articles, LinkedIn carousels, essays and other publications developed around the field of Learning Architecture.</p>
      <div class="hero-actions">
        <a class="button" href="#all-publications">Explore publications ↓</a>
        <a class="button secondary" href="https://sites.google.com/learningplanetinstitute.org/learning-architecture-lab/publications" target="_blank" rel="noopener">Open original page ↗</a>
      </div>
    </header>
  </div>

  <section class="site-shell" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Start here</div>
        <h2 id="featured-title">Explore the ideas</h2>
        <p class="section-note">A selection of themes that structure the lab’s work, from diagnosing learning systems to putting new approaches into practice.</p>
      </div>
    </div>
    <div class="featured-grid">
      <article class="featured-card">
        <div class="number">01</div><div class="tag">Diagnosis & critique</div>
        <h3>Understand the system before changing it</h3>
        <p>Explore the assumptions, power dynamics and structural conditions that shape learning and explain why well-intentioned reforms may fail.</p>
        <a class="text-link" href="#pillar-1">Explore this theme ↓</a>
      </article>
      <article class="featured-card">
        <div class="number">02</div><div class="tag">Paradigm shift</div>
        <h3>From learning design to learning architecture</h3>
        <p>Discover work that looks beyond individual activities or tools towards the wider systems, incentives and cultures that enable learning.</p>
        <a class="text-link" href="#pillar-2">Explore this theme ↓</a>
      </article>
      <article class="featured-card">
        <div class="number">03</div><div class="tag">Frameworks & application</div>
        <h3>Turn principles into practice</h3>
        <p>Find conceptual frameworks, methods and practical resources for shaping conditions for individual and collective learning.</p>
        <a class="text-link" href="#pillar-3">Explore the collection ↓</a>
      </article>
    </div>
  </section>

  <section class="collection" id="all-publications" aria-labelledby="collection-title">
    <div class="site-shell">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Browse the collection</div>
          <h2 id="collection-title">All publications</h2>
          <p class="section-note">Search by title or description, or narrow the collection by research pillar.</p>
        </div>
      </div>
      <div class="toolbar">
        <label><span class="eyebrow">Search</span><input id="search" type="search" placeholder="Title or keyword…" aria-label="Search publications"></label>
        <label><span class="eyebrow">Research pillar</span><select id="pillar" aria-label="Filter by research pillar"><option value="">All pillars</option></select></label>
        <label><span class="eyebrow">Content type</span><select id="kind" aria-label="Filter by content type"><option value="">All types</option><option value="Blog">Blogs</option><option value="Carousel">Carousels</option></select></label>
      </div>
      <div class="results-line"><span id="result-count" aria-live="polite"></span><button id="reset" class="button secondary" type="button">Reset filters</button></div>
      <div id="publication-list" class="publication-list"></div>
      <p class="small-print">Publication links must point to the original article or document. Where an individual destination was not available from the source page, the entry is marked for link verification rather than pointing to an invented URL.</p>
    </div>
  </section>

  <section class="site-shell" aria-labelledby="blogs-title">
    <div class="section-heading">
      <div>
        <div class="eyebrow">Long-form thinking</div>
        <h2 id="blogs-title">Blogs & essays</h2>
        <p class="section-note">Longer reflections on the assumptions behind learning systems and the conditions needed for transformation.</p>
      </div>
    </div>
    <div class="featured-grid" id="blog-cards"></div>
  </section>

  <section class="site-shell closing">
    <div class="closing-inner">
      <div>
        <div class="eyebrow">Stay connected</div>
        <h2>Continue exploring Learning Architecture</h2>
        <p>Visit the lab’s original page for institutional updates, related projects and current ways to get involved.</p>
      </div>
      <a class="button" href="https://sites.google.com/learningplanetinstitute.org/learning-architecture-lab/publications" target="_blank" rel="noopener">Visit the lab ↗</a>
    </div>
  </section>
</main>
<footer><div class="site-shell">Learning Architecture Lab · Learning Planet Institute <span style="float:right">Prototype for review</span></div></footer>

<script>
const sourcePage = "https://sites.google.com/learningplanetinstitute.org/learning-architecture-lab/publications";
const publications = [
  {title:"Learning is more than Cognition",pillar:"1 · Diagnosis and critique",kind:"Carousel",description:"Challenges traditional cognitive models by framing learning as an emotional, dialogic, and deeply relational human process."},
  {title:"Thinking like a Learning Architect #1",pillar:"1 · Diagnosis and critique",kind:"Carousel",description:"Explains why changing curriculum fails when underlying systemic structures, incentives, and cultures remain untouched."},
  {title:"What Gets Left Out When We Design Learning?",pillar:"1 · Diagnosis and critique",kind:"Carousel",description:"Exposes blind spots in standard instructional design by highlighting non-cognitive factors, power dynamics, and invisible system conditions often ignored."},
  {title:"Why Do Good Educational Programmes Still Fail?",pillar:"1 · Diagnosis and critique",kind:"Carousel",description:"Diagnoses how well-intentioned programmes collapse when implemented into unsupportive organizational architectures and hostile incentive structures."},
  {title:"Who Decides What Counts as Valid Knowledge?",pillar:"1 · Diagnosis and critique",kind:"Carousel",description:"Examines epistemic power dynamics, authority structures, and how institutional hierarchies dictate what knowledge is legitimized or erased."},
  {title:"We Need to Rethink Learning Design",pillar:"2 · Paradigm shift",kind:"Carousel",description:"Drawing on authors such as John Dewey, Donella Meadows, and Edwards Deming, it explains why we must shift from traditional Learning Design to Learning Architecture."},
  {title:"Rethinking the Architecture of Learning Systems",pillar:"2 · Paradigm shift",kind:"Carousel",description:"Argues that education is never neutral and that simply changing the curriculum or tools is not enough."},
  {title:"Thinking like a Learning Architect #2",pillar:"2 · Paradigm shift",kind:"Carousel",description:"Argues that AI cannot transform learning alone unless embedded within a redesigned architecture rather than legacy models."},
  {title:"Towards a Learning Society",pillar:"2 · Paradigm shift",kind:"Carousel",description:"Shifts the focus from formal schooling to a distributed, inquiry-driven ecosystem connecting society and collective intelligence."},
  {title:"What Is Learning Architecture?",pillar:"3 · Methodological frameworks",kind:"Carousel",description:"Introduces Learning Architecture through a conceptual explanation using the beaver analogy."},
  {title:"Ethical Dream Weaving as Learning Architecture Principles",pillar:"3 · Methodological frameworks",kind:"Carousel",description:"Establishes ethical and conceptual principles for designing systems capable of weaving desirable, regenerative, and collective futures."},
  {title:"What Conditions Enable People to Learn?",pillar:"3 · Methodological frameworks",kind:"Carousel",description:"Outlines eight essential systemic conditions required in an environment to convert information into real capability."},
  {title:"What Makes a Society Capable of Learning?",pillar:"3 · Methodological frameworks",kind:"Carousel",description:"Outlines macro-level systemic frameworks and social architectures required for collective learning, adaptability, and resilience."},
  {title:"What Makes Learning Happen Between People and Teams?",pillar:"3 · Methodological frameworks",kind:"Carousel",description:"Explores relational dynamics, psychological safety, and collective sense-making mechanisms that drive team-level learning."},
  {title:"Thinking like a Learning Architect #3",pillar:"4 · From intention to practice",kind:"Carousel",description:"Addresses how to move past isolated training workshops by embedding continuous capacity building directly into work practices."},
  {title:"Thinking like a Learning Architect #4",pillar:"4 · From intention to practice",kind:"Carousel",description:"Bridges high-level learning strategy with daily operational execution, decision-making, and organizational feedback loops."},
  {title:"Design Learning Systems for Coherence",pillar:"4 · From intention to practice",kind:"Carousel",description:"Introduces the 5C Framework—Capacity, Culture, Curriculum, Community, and Context—to align coherent learning systems at an institutional scale."},
  {title:"Learning Architecture Canvas for Policy Ecosystems",pillar:"5 · Institutional application",kind:"Carousel",description:"A practical framework tool designed to map, align, and structure learning architecture within institutional and policy ecosystems."}
];
const blogs = [
  {title:"Designing Learning for Complex Futures: Why the World Needs Learning Architects",description:"The paradox of an informed world incapable of transformation."},
  {title:"The Hidden Politics of Knowledge in Learning Systems",description:"Part I — Knowledge Architecture."}
];
const list = document.getElementById("publication-list");
const search = document.getElementById("search");
const pillar = document.getElementById("pillar");
const kind = document.getElementById("kind");
const count = document.getElementById("result-count");
[...new Set(publications.map(p=>p.pillar))].forEach(p=>{const o=document.createElement("option");o.value=p;o.textContent=p;pillar.appendChild(o);});
function makeLink(label, href=sourcePage) {
  const a=document.createElement("a"); a.className="publication-action"; a.href=href; a.target="_blank"; a.rel="noopener"; a.textContent=label+" ↗"; return a;
}
function render() {
  const q=search.value.trim().toLowerCase();
  const filtered=publications.filter(p=>(!q||(p.title+" "+p.description+" "+p.pillar).toLowerCase().includes(q))&&(!pillar.value||p.pillar===pillar.value)&&(!kind.value||p.kind===kind.value));
  list.replaceChildren(); count.textContent=`${filtered.length} ${filtered.length===1?"publication":"publications"}`;
  if(!filtered.length){const empty=document.createElement("div");empty.className="empty";empty.textContent="No publications match these filters. Try another keyword or reset the filters.";list.appendChild(empty);return;}
  filtered.forEach((p,i)=>{
    const article=document.createElement("article");article.className="publication";article.id="pillar-"+p.pillar[0];
    const idx=document.createElement("div");idx.className="publication-index";idx.textContent=String(i+1).padStart(2,"0");
    const body=document.createElement("div");
    const title=document.createElement("h3");title.textContent=p.title;
    const meta=document.createElement("div");meta.className="meta";
    const tag=document.createElement("span");tag.className="pill";tag.textContent=p.kind;
    const topic=document.createElement("span");topic.textContent=p.pillar;
    meta.append(tag,topic);
    const desc=document.createElement("p");desc.className="description";desc.textContent=p.description;
    body.append(title,meta,desc);
    article.append(idx,body,makeLink("View source"));
    list.appendChild(article);
  });
}
function renderBlogs(){
  const root=document.getElementById("blog-cards");
  blogs.forEach((b,i)=>{
    const card=document.createElement("article");card.className="featured-card";
    const n=document.createElement("div");n.className="number";n.textContent=String(i+1).padStart(2,"0");
    const tag=document.createElement("div");tag.className="tag";tag.textContent="Blog / essay";
    const title=document.createElement("h3");title.textContent=b.title;
    const desc=document.createElement("p");desc.textContent=b.description;
    const link=makeLink("Open original page");
    card.append(n,tag,title,desc,link);root.appendChild(card);
  });
}
search.addEventListener("input",render);pillar.addEventListener("change",render);kind.addEventListener("change",render);
document.getElementById("reset").addEventListener("click",()=>{search.value="";pillar.value="";kind.value="";render();});
render();renderBlogs();
</script>
</body>
</html>
